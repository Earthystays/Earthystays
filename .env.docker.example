# Local Docker PostgreSQL credentials for docker-compose (Phase 1B.5).
# Copy to .env.docker and adjust if desired. LOCAL DEV ONLY — not production.
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d
#
# These MUST match the DATABASE_URL you set in .env.local (see database-setup.md).
POSTGRES_USER=earthy
POSTGRES_PASSWORD=earthy_local_dev
POSTGRES_DB=earthy_dev
POSTGRES_PORT=5432
