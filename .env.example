# Earthy Stays — environment variables
# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.production` on the VPS and fill the real values.
# Never commit `.env.production` to git (it's already in .gitignore via .env*).
#
# To generate a random SESSION_SECRET:
#   openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

# REQUIRED — used to sign session cookies (login, wishlist) and OAuth state.
# Must be a long random string. Rotating it logs out all users.
SESSION_SECRET=

# REQUIRED — password to enter /admin. Pick something strong.
ADMIN_PASSWORD=

# OPTIONAL — Google OAuth (lets guests sign in with Google).
# Get from https://console.cloud.google.com → APIs & Services → Credentials.
# In Google Console, add this exact redirect URI:
#   https://earthystays.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OPTIONAL — Resend (resend.com) for emailing inquiry notifications.
# Free tier: 3,000 emails/month. Verify the earthystays.com domain in
# Resend's dashboard, then paste the API key here.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=reservations@earthyrooms.com
INQUIRY_FROM_EMAIL=Earthy Stays <reservations@earthystays.com>

# ── Analytics & SEO ─────────────────────────────────────────────────────

# OPTIONAL — Google Analytics 4. Free.
# Get it from analytics.google.com → Admin → Data Streams → your web
# stream → "Measurement ID" (looks like G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=

# OPTIONAL — Meta (Facebook/Instagram) Pixel. Free.
# Get it from business.facebook.com/events_manager → your pixel →
# Settings → "Pixel ID" (a numeric string). Used both client-side (this
# var) and server-side for the Conversions API (FB_PIXEL_ID below) — use
# the same value for both.
NEXT_PUBLIC_FB_PIXEL_ID=

# OPTIONAL — Microsoft Clarity (free session recording + heatmaps).
# Get it from clarity.microsoft.com → your project → Settings →
# "Setup" tab → the project id in the tracking snippet.
NEXT_PUBLIC_CLARITY_ID=

# OPTIONAL — Meta Conversions API (server-side backup of the Pixel events
# above; improves match quality and survives ad blockers/iOS tracking
# prevention). Requires NEXT_PUBLIC_FB_PIXEL_ID to also be set.
# FB_PIXEL_ID: same numeric Pixel ID as NEXT_PUBLIC_FB_PIXEL_ID above.
# FB_ACCESS_TOKEN: business.facebook.com/events_manager → your pixel →
#   Settings → Conversions API → "Generate access token". Keep secret —
#   this is a write credential, never expose it client-side.
FB_PIXEL_ID=
FB_ACCESS_TOKEN=

# OPTIONAL — IndexNow key (lets Bing and other participating search
# engines know instantly when a villa page is added/changed, instead of
# waiting for the next crawl). Any random string works — generate one
# with `openssl rand -hex 16`. No account/signup needed; the key just
# needs to be served back at /indexnow-key.txt, which this app already
# does automatically once this var is set.
INDEXNOW_KEY=

# OPTIONAL — sends every inquiry-form submission to the Earthy Leads
# dashboard (earthy-leads.vercel.app) as a new Website lead, in addition
# to the existing WhatsApp/email notifications. LEADS_DASHBOARD_SECRET
# must match WEBSITE_INQUIRY_SECRET set in that project.
LEADS_DASHBOARD_URL=https://earthy-leads.vercel.app
LEADS_DASHBOARD_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# PostgreSQL (Phase 1B.5 — financial foundation).
# The app is still JSON-backed; the database connection is opened LAZILY and
# is only required once a code path actually touches it. Point this at a LOCAL
# dev database — never production credentials during Phase 1B.5.
#   Create locally:  createdb earthy_dev
#   Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://localhost:5432/earthy_dev
# Optional connection-pool ceiling (default 5).
DATABASE_POOL_MAX=5
